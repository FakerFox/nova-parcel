{
  "name": "nova-parcel-windows",
  "productName": "Nova Parcel",
  "version": "0.3.0",
  "description": "Неофіційний віджет Нової пошти для Windows",
  "author": "FakerFox",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test tests/*.test.cjs && node ../Tests/bridge.test.cjs",
    "smoke": "electron . --smoke-test",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "preview": "node scripts/preview.cjs"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ua.local.novaparcel.windows",
    "productName": "Nova Parcel",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["src/**/*", "assets/icon.png", "assets/icon.ico", "package.json"],
    "extraResources": [{ "from": "../Resources/Bridge.js", "to": "Bridge.js" }],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Nova-Parcel-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Parcel",
      "runAfterFinish": true
    }
  }
}
